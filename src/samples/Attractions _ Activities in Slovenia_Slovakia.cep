      "data": {
        "query": "PREFIX osmkey: <https://www.openstreetmap.org/wiki/Key:>\nPREFIX geo: <http://www.opengis.net/ont/geosparql#>\nPREFIX ogc: <http://www.opengis.net/rdf#>\nPREFIX osmrel: <https://www.openstreetmap.org/relation/>\n\nSELECT DISTINCT ?type ?name ?description ?image ?website ?wikipedia ?wikidata ?wkt WHERE {\n  osmrel:14296 ogc:sfContains ?osm_id .\n\n  {\n    ?osm_id osmkey:tourism ?type .\n    VALUES ?type { \"attraction\" \"activity\" \"tourism\" \"museum\" }\n  }\n  UNION\n  {\n    ?osm_id osmkey:leisure \"water_park\" .\n    BIND(\"water_park\" AS ?type)\n  }\n  UNION\n  {\n    ?osm_id osmkey:natural \"cave_entrance\" .\n    BIND(\"cave\" AS ?type)\n  }\n  UNION\n  {\n    ?osm_id osmkey:sport ?type .\n    VALUES ?type { \"canyoning\" \"whitewater_rafting\" }\n  }\n\n  ?osm_id osmkey:name ?name ;\n          osmkey:website ?website ;\n          geo:hasGeometry/geo:asWKT ?wkt .\n\n  OPTIONAL { ?osm_id osmkey:description ?description }\n  OPTIONAL { ?osm_id osmkey:wikipedia ?wikipedia }\n  OPTIONAL { ?osm_id osmkey:wikidata ?wikidata }\n\n  FILTER(BOUND(?wikipedia) || BOUND(?wikidata))\n}\nLIMIT 200",
